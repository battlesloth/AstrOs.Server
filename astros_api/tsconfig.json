{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "src/*": [
        "src/*"
      ]
    },
    "plugins": [
      {
        "transform": "@zerollup/ts-transform-paths",
        "exclude": [
          "*"
        ]
      }
    ]
  },
  "typeAcquisition": {
    "include": [
      "jest"
    ]
  },
  // When adding a new src/-resident pattern here, mirror it in
  // src/test_harness/global_setup.ts:newestCompiledMtime — the vitest
  // globalSetup walker filters this list by hand to decide whether dist/
  // is stale before integration tests run.
  "exclude": [
    "./vitest.config.ts",
    "./vitest.config.js",
    "./webpack.config.js",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}